{
  "name": "sim-agentation",
  "version": "0.1.0",
  "private": true,
  "description": "Annotate a running iOS simulator in the browser and hand the feedback to coding agents over MCP.",
  "type": "module",
  "scripts": {
    "build": "vite build && swift build --package-path app/host",
    "dev": "vite",
    "watch": "vite build --watch",
    "start": "app/host/.build/debug/sim-agentation serve --open",
    "mcp": "app/host/.build/debug/sim-agentation mcp"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.1",
    "vite": "8.3.2"
  }
}
