{
  "name": "sim-agentation",
  "version": "0.1.0",
  "description": "Annotate a running iOS simulator in the browser and hand the feedback to coding agents over MCP.",
  "type": "module",
  "bin": {
    "sim-agentation": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun src/cli.ts serve --open",
    "mcp": "bun src/cli.ts mcp"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "license": "MIT",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.1",
    "vite": "8.3.2"
  }
}
